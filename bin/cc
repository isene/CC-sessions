#!/usr/bin/env ruby
# frozen_string_literal: true

# CC - Claude Code Session Manager
# Easily bookmark and resume Claude Code sessions with tags
#
# Usage:
#   cc              - Continue session in current dir, or start new
#   cc <tag>        - Resume session bookmarked with <tag>
#   cc -l, --list   - List all bookmarked sessions
#   cc -h, --help   - Show help
#
# Bookmarking (in Claude Code):
#   /bm tag1 tag2   - Bookmark current session with tags

require 'json'
require 'fileutils'
require 'io/console'

# Simple ANSI helpers
def cyan(s)  = "\e[36m#{s}\e[0m"
def dim(s)   = "\e[2m#{s}\e[0m"
def red(s)   = "\e[31m#{s}\e[0m"
def rev(s)   = "\e[7m#{s}\e[0m"
def clear_line = "\e[2K\r"

CONFIG_DIR = File.expand_path('~/.cc-sessions')
BOOKMARKS_FILE = File.join(CONFIG_DIR, 'bookmarks.json')
COMMAND_SOURCE = File.expand_path('../commands/bm.md', __dir__)
COMMAND_DEST = File.expand_path('~/.claude/commands/bm.md')
SETTINGS_FILE = File.expand_path('~/.claude/settings.json')
BM_PERMISSION = 'Bash(cc-bookmark:*)'

def ensure_setup
  # Create config directory
  FileUtils.mkdir_p(CONFIG_DIR) unless Dir.exist?(CONFIG_DIR)

  # Install /bm command if not present
  unless File.exist?(COMMAND_DEST)
    if File.exist?(COMMAND_SOURCE)
      FileUtils.mkdir_p(File.dirname(COMMAND_DEST))
      FileUtils.cp(COMMAND_SOURCE, COMMAND_DEST)
      puts "Installed /bm command to #{COMMAND_DEST}"
      puts "You can now use '/bm tag1 tag2' in Claude Code to bookmark sessions."
      puts
    end
  end

  # Add auto-accept permission for /bm command
  ensure_permission
end

def ensure_permission
  settings = if File.exist?(SETTINGS_FILE)
               JSON.parse(File.read(SETTINGS_FILE))
             else
               {}
             end

  settings['permissions'] ||= {}
  settings['permissions']['allow'] ||= []

  unless settings['permissions']['allow'].include?(BM_PERMISSION)
    settings['permissions']['allow'] << BM_PERMISSION
    FileUtils.mkdir_p(File.dirname(SETTINGS_FILE))
    File.write(SETTINGS_FILE, JSON.pretty_generate(settings))
    puts "Added auto-accept permission for /bm command"
    puts
  end
rescue JSON::ParserError
  # If settings.json is malformed, skip permission setup
  warn "Warning: Could not parse ~/.claude/settings.json - skipping permission setup"
end

def load_bookmarks
  return {} unless File.exist?(BOOKMARKS_FILE)
  JSON.parse(File.read(BOOKMARKS_FILE))
rescue JSON::ParserError
  {}
end

def find_session_by_tag(tag)
  bookmarks = load_bookmarks
  bookmarks.each do |path, tags|
    return path if tags.include?(tag)
  end
  nil
end

def session_exists_in_dir?(dir)
  # Check for .claude directory with session files
  claude_dir = File.join(dir, '.claude')
  return false unless Dir.exist?(claude_dir)

  # Look for conversation files or other session indicators
  Dir.glob(File.join(claude_dir, '**/*')).any? { |f| File.file?(f) }
end

def read_key
  input = $stdin.getch
  if input == "\e"
    begin
      input << $stdin.read_nonblock(3)
    rescue IO::WaitReadable
    end
  end
  case input
  when "\e[A", "k" then :up
  when "\e[B", "j" then :down
  when "\r", "\n"  then :enter
  when "q", "\e"   then :quit
  when "d"         then :delete
  else nil
  end
end

def save_bookmarks(bookmarks)
  File.write(BOOKMARKS_FILE, JSON.pretty_generate(bookmarks))
end

def delete_bookmark_by_tag(tag)
  bookmarks = load_bookmarks
  path = find_session_by_tag(tag)

  if path
    bookmarks.delete(path)
    save_bookmarks(bookmarks)
    puts "Deleted bookmark: #{path}"
    puts "  (was tagged: #{tag})"
  else
    puts "No session found with tag '#{tag}'"
    exit 1
  end
end

def list_bookmarks
  bookmarks = load_bookmarks

  if bookmarks.empty?
    puts "No bookmarked sessions."
    puts
    puts "To bookmark a session, use '/bm tag1 tag2' in Claude Code."
    return
  end

  items = bookmarks.map do |path, tags|
    { path: path, tags: tags, exists: Dir.exist?(path) }
  end

  index = 0
  puts "Select session (↑/↓/j/k move, Enter select, d delete, q quit):\n\n"

  # Hide cursor
  print "\e[?25l"

  begin
    loop do
      # Render list
      items.each_with_index do |item, i|
        print clear_line
        tag_str = cyan(item[:tags].join(', '))
        path_str = dim(item[:path])
        missing = item[:exists] ? '' : red(' [NOT FOUND]')
        line = "#{tag_str} → #{path_str}#{missing}"

        if i == index
          puts "▸ #{line}"
        else
          puts "  #{line}"
        end
      end

      # Move cursor back to start
      print "\e[#{items.size}A"

      key = read_key
      case key
      when :up
        index = (index - 1) % items.size
      when :down
        index = (index + 1) % items.size
      when :delete
        # Show confirmation
        old_size = items.size
        print "\e[#{old_size}B"  # Move below list
        print clear_line
        print "Delete '#{items[index][:tags].join(', ')}'? (y/n) "
        confirm = $stdin.getch
        if confirm.downcase == 'y'
          bookmarks.delete(items[index][:path])
          save_bookmarks(bookmarks)
          items.delete_at(index)
          index = [index, items.size - 1].min
          if items.empty?
            # Clear list and confirmation line
            print "\e[#{old_size}A"
            (old_size + 1).times { print clear_line; puts }
            print "\e[#{old_size + 1}A"
            puts "All bookmarks deleted."
            return
          end
          # Clear old list (one more line than new size)
          print clear_line
          print "\e[#{old_size}A"
          (old_size).times { print clear_line; puts }
          print "\e[#{old_size}A"
        else
          print clear_line
          print "\e[#{old_size}A"
        end
      when :enter
        # Clear the menu
        (items.size).times { print clear_line; puts }
        print "\e[#{items.size}A"

        if items[index][:exists]
          print "\e[?25h"  # Show cursor before exec
          resume_session(items[index][:path])
        else
          puts red("Directory not found: #{items[index][:path]}")
        end
        return
      when :quit
        # Clear the menu
        (items.size).times { print clear_line; puts }
        print "\e[#{items.size}A"
        return
      end
    end
  ensure
    # Always show cursor
    print "\e[?25h"
  end
end

def show_help
  puts <<~HELP
    CC - Claude Code Session Manager

    Easily bookmark and resume Claude Code sessions with tags.

    USAGE:
      cc              Continue session in current directory, or start new
      cc <tag>        Resume session bookmarked with <tag>
      cc -l, --list   List all bookmarked sessions (interactive)
      cc -d, --delete <tag>  Delete bookmark matching <tag>
      cc -h, --help   Show this help

    BOOKMARKING (inside Claude Code):
      /bm tag1 tag2   Bookmark current session with one or more tags

    EXAMPLES:
      cc rtfm         Resume session tagged 'rtfm'
      cc              Continue in current dir or start fresh
      cc -l           Show interactive list (d to delete, Enter to select)
      cc -d rtfm      Delete bookmark tagged 'rtfm'

    FILES:
      ~/.cc-sessions/bookmarks.json   Bookmark storage
      ~/.claude/commands/bm.md        The /bm command definition

    FIRST RUN:
      On first run, cc installs the /bm command to ~/.claude/commands/
      This enables the '/bm' command inside Claude Code sessions.
  HELP
end

def resume_session(path)
  unless Dir.exist?(path)
    puts "Error: Directory not found: #{path}"
    exit 1
  end

  Dir.chdir(path) do
    puts "Resuming session in: #{path}"
    # Use -c to continue most recent session in this directory (no picker)
    exec('claude', '-c')
  end
end

def continue_or_start
  if session_exists_in_dir?(Dir.pwd)
    exec('claude', '-c')
  else
    exec('claude')
  end
end

# Main
ensure_setup

case ARGV[0]
when '-h', '--help'
  show_help
when '-l', '--list'
  list_bookmarks
when '-d', '--delete'
  if ARGV[1]
    delete_bookmark_by_tag(ARGV[1])
  else
    puts "Usage: cc -d <tag>"
    puts "Delete bookmark matching the given tag."
    exit 1
  end
when nil
  continue_or_start
else
  tag = ARGV[0]
  path = find_session_by_tag(tag)

  if path
    resume_session(path)
  else
    puts "No session found with tag '#{tag}'"
    puts
    puts "Available tags:"
    bookmarks = load_bookmarks
    if bookmarks.empty?
      puts "  (none - use '/bm tag1 tag2' in Claude Code to bookmark)"
    else
      all_tags = bookmarks.values.flatten.uniq.sort
      all_tags.each { |t| puts "  #{t}" }
    end
    exit 1
  end
end

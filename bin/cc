#!/usr/bin/env ruby
# frozen_string_literal: true

# CC - Claude Code Session Manager
# Easily bookmark and resume Claude Code sessions with tags
#
# Usage:
#   cc              - Continue session in current dir, or start new
#   cc <tag>        - Resume session bookmarked with <tag>
#   cc -l, --list   - List all bookmarked sessions
#   cc -C, --current - Show currently running Claude Code sessions
#   cc -h, --help   - Show help
#
# Bookmarking (in Claude Code):
#   /bm tag1 tag2   - Bookmark current session with tags

require 'json'
require 'fileutils'
require 'io/console'
require 'set'

# Simple ANSI helpers
def cyan(s)  = "\e[36m#{s}\e[0m"
def green(s) = "\e[32m#{s}\e[0m"
def dim(s)   = "\e[2m#{s}\e[0m"
def red(s)   = "\e[31m#{s}\e[0m"
def rev(s)   = "\e[7m#{s}\e[0m"
def clear_line = "\e[2K\r"

# When running under sudo, ensure files stay owned by the real user
def fix_ownership(*paths)
  return unless Process.uid == 0 || ENV['SUDO_USER']
  target_user = ENV['SUDO_USER'] || 'geir'
  require 'etc'
  pw = Etc.getpwnam(target_user)
  paths.each { |p| File.chown(pw.uid, pw.gid, p) }
rescue
  nil
end

CONFIG_DIR = File.expand_path('~/.cc-sessions')
BOOKMARKS_FILE = File.join(CONFIG_DIR, 'bookmarks.json')
COMMAND_SOURCE = File.expand_path('../commands/bm.md', __dir__)
COMMAND_DEST = File.expand_path('~/.claude/commands/bm.md')
SETTINGS_FILE = File.expand_path('~/.claude/settings.json')
BM_PERMISSION = 'Bash(cc-bookmark:*)'
CLAUDE_PROJECTS = File.expand_path('~/.claude/projects')

def ensure_setup
  FileUtils.mkdir_p(CONFIG_DIR) unless Dir.exist?(CONFIG_DIR)

  unless File.exist?(COMMAND_DEST)
    if File.exist?(COMMAND_SOURCE)
      FileUtils.mkdir_p(File.dirname(COMMAND_DEST))
      FileUtils.cp(COMMAND_SOURCE, COMMAND_DEST)
      puts "Installed /bm command to #{COMMAND_DEST}"
      puts "You can now use '/bm tag1 tag2' in Claude Code to bookmark sessions."
      puts
    end
  end

  ensure_permission
end

def ensure_permission
  settings = if File.exist?(SETTINGS_FILE)
               JSON.parse(File.read(SETTINGS_FILE))
             else
               {}
             end

  settings['permissions'] ||= {}
  settings['permissions']['allow'] ||= []

  unless settings['permissions']['allow'].include?(BM_PERMISSION)
    settings['permissions']['allow'] << BM_PERMISSION
    FileUtils.mkdir_p(File.dirname(SETTINGS_FILE))
    File.write(SETTINGS_FILE, JSON.pretty_generate(settings))
    puts "Added auto-accept permission for /bm command"
    puts
  end
rescue JSON::ParserError
  warn "Warning: Could not parse ~/.claude/settings.json - skipping permission setup"
end

def resolve_session_dir(cwd)
  path = cwd
  loop do
    encoded = path.gsub('/', '-')
    return path if Dir.exist?(File.join(CLAUDE_PROJECTS, encoded))
    parent = File.dirname(path)
    break if parent == path
    path = parent
  end
  cwd
end

def detect_session_id(session_dir)
  encoded = session_dir.gsub('/', '-')
  project_dir = File.join(CLAUDE_PROJECTS, encoded)
  return nil unless Dir.exist?(project_dir)

  newest = Dir.glob(File.join(project_dir, '*.jsonl'))
               .select { |f| File.file?(f) }
               .max_by { |f| File.mtime(f) }
  return nil unless newest

  File.basename(newest, '.jsonl')
end

def load_bookmarks
  unless File.exist?(BOOKMARKS_FILE)
    return { 'version' => 2, 'sessions' => {} }
  end

  data = JSON.parse(File.read(BOOKMARKS_FILE))
  if data['version']
    data
  else
    migrate_bookmarks(data)
  end
rescue JSON::ParserError
  { 'version' => 2, 'sessions' => {} }
end

def migrate_bookmarks(old_data)
  sessions = {}
  old_data.each do |path, tags|
    sid = detect_session_id(path)
    key = sid || "path:#{path}"
    sessions[key] = { 'path' => path, 'tags' => tags }
  end
  new_data = { 'version' => 2, 'sessions' => sessions }
  save_bookmarks(new_data)
  new_data
end

def save_bookmarks(bookmarks)
  FileUtils.mkdir_p(CONFIG_DIR) unless Dir.exist?(CONFIG_DIR)
  File.write(BOOKMARKS_FILE, JSON.pretty_generate(bookmarks))
  fix_ownership(BOOKMARKS_FILE)
end

def find_session_by_tag(tag)
  bookmarks = load_bookmarks
  bookmarks['sessions'].each do |id, entry|
    if entry['tags'].include?(tag)
      return { id: id, path: entry['path'] }
    end
  end
  nil
end

def find_tags_for_session_dir(session_dir, bookmarks)
  session_id = detect_session_id(session_dir)
  return [] unless session_id

  entry = bookmarks['sessions'][session_id]
  entry ? entry['tags'] : []
end

def session_exists_in_dir?(dir)
  claude_dir = File.join(dir, '.claude')
  return false unless Dir.exist?(claude_dir)
  Dir.glob(File.join(claude_dir, '**/*')).any? { |f| File.file?(f) }
end

def read_key
  input = $stdin.getch
  if input == "\e"
    begin
      input << $stdin.read_nonblock(5)
    rescue IO::WaitReadable
    end
  end
  case input
  when "\e[A", "k"      then :up
  when "\e[B", "j"      then :down
  when "\e[1;2A", "K"   then :move_up
  when "\e[1;2B", "J"   then :move_down
  when "\r", "\n"       then :enter
  when "q", "\e"        then :quit
  when "d"              then :delete
  else nil
  end
end

def delete_bookmark_by_tag(tag)
  bookmarks = load_bookmarks
  match = find_session_by_tag(tag)

  if match
    bookmarks['sessions'].delete(match[:id])
    save_bookmarks(bookmarks)
    puts "Deleted bookmark: #{match[:path]}"
    puts "  (was tagged: #{tag})"
  else
    puts "No session found with tag '#{tag}'"
    exit 1
  end
end

def running_session_ids
  pids = `pgrep -x claude 2>/dev/null`.split.map(&:to_i)
  ids = Set.new
  pids.each do |pid|
    cwd_link = "/proc/#{pid}/cwd"
    next unless File.exist?(cwd_link)
    begin
      session_dir = resolve_session_dir(File.readlink(cwd_link))
      sid = detect_session_id(session_dir)
      ids << sid if sid
    rescue Errno::EACCES
    end
  end
  ids
end

def list_bookmarks
  bookmarks = load_bookmarks

  if bookmarks['sessions'].empty?
    puts "No bookmarked sessions."
    puts
    puts "To bookmark a session, use '/bm tag1 tag2' in Claude Code."
    return
  end

  running = running_session_ids

  items = bookmarks['sessions'].map do |id, entry|
    { id: id, path: entry['path'], tags: entry['tags'], exists: Dir.exist?(entry['path']),
      running: running.include?(id) }
  end

  index = 0
  puts "Select session (\u2191/\u2193/j/k move, J/K reorder, Enter select, d delete, q quit):\n\n"

  print "\e[?25l"

  begin
    loop do
      items.each_with_index do |item, i|
        print clear_line
        tag_str = cyan(item[:tags].join(', '))
        path_str = dim(item[:path])
        status = if !item[:exists]
                   red(' [NOT FOUND]')
                 elsif item[:running]
                   green(' ●')
                 else
                   ''
                 end
        line = "#{tag_str} \u2192 #{path_str}#{status}"

        if i == index
          puts "\u25b8 #{line}"
        else
          puts "  #{line}"
        end
      end

      print "\e[#{items.size}A"

      key = read_key
      case key
      when :up
        index = (index - 1) % items.size
      when :down
        index = (index + 1) % items.size
      when :move_up
        if index > 0
          items[index], items[index - 1] = items[index - 1], items[index]
          index -= 1
          rebuild_and_save(items)
        end
      when :move_down
        if index < items.size - 1
          items[index], items[index + 1] = items[index + 1], items[index]
          index += 1
          rebuild_and_save(items)
        end
      when :delete
        old_size = items.size
        print "\e[#{old_size}B"
        print clear_line
        print "Delete '#{items[index][:tags].join(', ')}'? (y/n) "
        confirm = $stdin.getch
        if confirm.downcase == 'y'
          deleted = items.delete_at(index)
          rebuild_and_save(items)
          index = [index, items.size - 1].min
          if items.empty?
            print "\e[#{old_size}A"
            (old_size + 1).times { print clear_line; puts }
            print "\e[#{old_size + 1}A"
            puts "All bookmarks deleted."
            return
          end
          print clear_line
          print "\e[#{old_size}A"
          (old_size).times { print clear_line; puts }
          print "\e[#{old_size}A"
        else
          print clear_line
          print "\e[#{old_size}A"
        end
      when :enter
        (items.size).times { print clear_line; puts }
        print "\e[#{items.size}A"

        if items[index][:exists]
          print "\e[?25h"
          resume_session(items[index][:id], items[index][:path])
        else
          puts red("Directory not found: #{items[index][:path]}")
        end
        return
      when :quit
        (items.size).times { print clear_line; puts }
        print "\e[#{items.size}A"
        return
      end
    end
  ensure
    print "\e[?25h"
  end
end

def rebuild_and_save(items)
  sessions = {}
  items.each { |item| sessions[item[:id]] = { 'path' => item[:path], 'tags' => item[:tags] } }
  save_bookmarks({ 'version' => 2, 'sessions' => sessions })
end

def show_current_sessions
  pids = `pgrep -x claude 2>/dev/null`.split.map(&:to_i)

  if pids.empty?
    puts "No Claude Code sessions currently running."
    return
  end

  bookmarks = load_bookmarks

  puts "Running sessions:\n\n"

  pids.each do |pid|
    cwd_link = "/proc/#{pid}/cwd"
    next unless File.exist?(cwd_link)

    begin
      cwd = File.readlink(cwd_link)
      session_dir = resolve_session_dir(cwd)
      tags = find_tags_for_session_dir(session_dir, bookmarks)
      tag_str = tags.empty? ? dim('(no tags)') : green(tags.join(', '))

      puts "  PID #{cyan(pid.to_s)}: #{session_dir}"
      puts "         Tags: #{tag_str}"
      puts
    rescue Errno::EACCES
      puts "  PID #{cyan(pid.to_s)}: #{dim('(permission denied)')}"
      puts
    end
  end
end

def show_help
  puts <<~HELP
    CC - Claude Code Session Manager

    Easily bookmark and resume Claude Code sessions with tags.

    USAGE:
      cc                     Continue session in current dir, or start new
      cc <tag>               Resume session bookmarked with <tag>
      cc -l, --list          Interactive list of bookmarked sessions
      cc -C, --current       Show currently running Claude Code sessions
      cc -d, --delete <tag>  Delete bookmark matching <tag>
      cc -h, --help          Show this help

    BOOKMARKING (inside Claude Code):
      /bm tag1 tag2   Bookmark current session with one or more tags

    EXAMPLES:
      cc rtfm         Resume session tagged 'rtfm'
      cc              Continue in current dir or start fresh
      cc -l           Show interactive list (d to delete, Enter to select)
      cc -C           Show running sessions with their tags
      cc -d rtfm      Delete bookmark tagged 'rtfm'

    FILES:
      ~/.cc-sessions/bookmarks.json   Bookmark storage
      ~/.claude/commands/bm.md        The /bm command definition

    FIRST RUN:
      On first run, cc installs the /bm command to ~/.claude/commands/
      This enables the '/bm' command inside Claude Code sessions.
  HELP
end

def resume_session(session_id, path)
  unless Dir.exist?(path)
    puts "Error: Directory not found: #{path}"
    exit 1
  end

  bookmarks = load_bookmarks
  entry = bookmarks['sessions'][session_id]

  # Auto-migrate: if a newer session exists (context continuation), use it
  unless session_id.start_with?('path:')
    session_dir = resolve_session_dir(path)
    newest_id = detect_session_id(session_dir)
    if newest_id && newest_id != session_id && entry
      puts dim("Session was continued — following to latest.")
      bookmarks['sessions'].delete(session_id)
      bookmarks['sessions'][newest_id] = entry
      save_bookmarks(bookmarks)
      # Clean up old breadcrumb if any
      FileUtils.rm_f(File.join(CONFIG_DIR, 'resumed', "#{session_id}.json"))
      session_id = newest_id
    end
  end

  # Save resume breadcrumb so cc-bookmark can track session continuations
  # (when context resets, Claude creates a new session ID)
  if entry && !session_id.start_with?('path:')
    resume_dir = File.join(CONFIG_DIR, 'resumed')
    FileUtils.mkdir_p(resume_dir)
    breadcrumb = File.join(resume_dir, "#{session_id}.json")
    File.write(breadcrumb, entry['tags'].to_json)
    fix_ownership(breadcrumb)
  end

  Dir.chdir(path) do
    # Emit OSC 7 so wezterm knows the new cwd (for Alt+n, etc.)
    host = `hostname`.strip
    print "\033]7;file://#{host}#{path}\007"
    puts "Resuming session in: #{path}"

    # Export session info so cc-bookmark/hooks can reliably identify this session
    ENV['CC_SESSION_ID'] = session_id
    tags = entry ? entry['tags'].join(',') : ''
    ENV['CC_RESUME_TAGS'] = tags unless tags.empty?

    if session_id.start_with?('path:')
      exec('claude', '-c')
    else
      exec('claude', '--resume', session_id)
    end
  end
end

def continue_or_start
  # Emit OSC 7 so wezterm knows the cwd
  host = `hostname`.strip
  print "\033]7;file://#{host}#{Dir.pwd}\007"
  if session_exists_in_dir?(Dir.pwd)
    exec('claude', '-c')
  else
    exec('claude')
  end
end

# Main
ensure_setup

case ARGV[0]
when '-h', '--help'
  show_help
when '-l', '--list'
  list_bookmarks
when '-C', '--current'
  show_current_sessions
when '-d', '--delete'
  if ARGV[1]
    delete_bookmark_by_tag(ARGV[1])
  else
    puts "Usage: cc -d <tag>"
    puts "Delete bookmark matching the given tag."
    exit 1
  end
when nil
  continue_or_start
else
  tag = ARGV[0]
  match = find_session_by_tag(tag)

  if match
    resume_session(match[:id], match[:path])
  else
    puts "No session found with tag '#{tag}'"
    puts
    puts "Available tags:"
    bookmarks = load_bookmarks
    if bookmarks['sessions'].empty?
      puts "  (none - use '/bm tag1 tag2' in Claude Code to bookmark)"
    else
      all_tags = bookmarks['sessions'].values.flat_map { |e| e['tags'] }.uniq.sort
      all_tags.each { |t| puts "  #{t}" }
    end
    exit 1
  end
end
